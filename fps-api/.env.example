# fps-api 환경 변수 예시 — 실제 값은 Coolify 환경 변수에만(이 파일엔 비밀 금지)
# 공유 Postgres(비우면 로컬 SQLite 파일 fps_api.sqlite3)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# 클라이언트(Unity OnlineConfig.Key)와 같은 서명 키 — 빌드에 들어가므로 "비밀"이 아니라 교체용 값
FPS_API_KEY=change-me
# /api/stats 관리자 키(비우면 통계 엔드포인트 비활성)
FPS_ADMIN_KEY=
# IP 해시 솔트(비우면 프로세스마다 무작위)
FPS_IP_SALT=
# 신뢰할 클라이언트 IP 헤더(Cloudflare 터널 뒤 = CF-Connecting-IP, 직접 노출이면 비움)
FPS_IP_HEADER=CF-Connecting-IP
# 추가 CORS 오리진(쉼표 구분)
FPS_EXTRA_ORIGINS=
# 점수 상한 여유 배수(변형 규칙으로 점수가 커지면 올림)
FPS_SCORE_SLACK=1.5
