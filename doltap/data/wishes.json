{"version": 1, "items": [
  {"id": "w01", "text": "온 가족이 둘러앉아 웃기를", "tone": "가족"},
  {"id": "w02", "text": "부모님께 안부를 자주 묻기를", "tone": "가족"},
  {"id": "w03", "text": "아이의 하루가 환하기를", "tone": "가족"},
  {"id": "w04", "text": "형제가 서로 기대어 걷기를", "tone": "가족"},
  {"id": "w05", "text": "할머니 밥상이 늘 따뜻하길", "tone": "가족"},
  {"id": "w06", "text": "멀리 사는 동생도 잘 지내기를", "tone": "가족"},
  {"id": "w07", "text": "주말엔 다 같이 늦잠 자기를", "tone": "가족"},
  {"id": "w08", "text": "우리 집 창에 햇살 들기를", "tone": "가족"},
  {"id": "w09", "text": "아버지 웃는 날이 많아지기를", "tone": "가족"},
  {"id": "w10", "text": "엄마의 잔소리가 오래 들리길", "tone": "가족"},
  {"id": "w11", "text": "명절에 다 함께 모이기를", "tone": "가족"},
  {"id": "w12", "text": "올해도 가족사진 함께 찍기를", "tone": "가족"},
  {"id": "w13", "text": "아픈 데 없이 가뿐하기를", "tone": "건강"},
  {"id": "w14", "text": "무릎이 오래 튼튼하기를", "tone": "건강"},
  {"id": "w15", "text": "감기 없이 겨울 나기를", "tone": "건강"},
  {"id": "w16", "text": "숨이 가볍고 몸이 편하길", "tone": "건강"},
  {"id": "w17", "text": "매일 밥맛이 좋기를", "tone": "건강"},
  {"id": "w18", "text": "푹 자고 개운히 깨기를", "tone": "건강"},
  {"id": "w19", "text": "허리 펴고 산길 오르길", "tone": "건강"},
  {"id": "w20", "text": "약 없이 한 해 보내기를", "tone": "건강"},
  {"id": "w21", "text": "눈이 맑고 귀가 밝기를", "tone": "건강"},
  {"id": "w22", "text": "뭉친 어깨가 스르르 풀리기를", "tone": "건강"},
  {"id": "w23", "text": "계절 바뀌어도 탈 없기를", "tone": "건강"},
  {"id": "w24", "text": "오늘 걸은 만큼 힘이 붙기를", "tone": "건강"},
  {"id": "w25", "text": "준비한 만큼 다 보여 주기를", "tone": "합격"},
  {"id": "w26", "text": "아는 문제만 쏙쏙 나오기를", "tone": "합격"},
  {"id": "w27", "text": "면접장에서 목소리 떨리지 않길", "tone": "합격"},
  {"id": "w28", "text": "서류 심사를 거뜬히 넘기를", "tone": "합격"},
  {"id": "w29", "text": "이직의 문이 활짝 열리기를", "tone": "합격"},
  {"id": "w30", "text": "시험지 앞에서 침착하기를", "tone": "합격"},
  {"id": "w31", "text": "첫 출근길이 설레기를", "tone": "합격"},
  {"id": "w32", "text": "기다리던 소식이 오기를", "tone": "합격"},
  {"id": "w33", "text": "마지막 문제까지 풀어내길", "tone": "합격"},
  {"id": "w34", "text": "자격증을 손에 쥐기를", "tone": "합격"},
  {"id": "w35", "text": "내 이름이 명단에 있기를", "tone": "합격"},
  {"id": "w36", "text": "발표 날 웃으며 전화하기를", "tone": "합격"},
  {"id": "w37", "text": "마음이 닿는 사람 만나기를", "tone": "사랑"},
  {"id": "w38", "text": "서로의 손을 놓지 않기를", "tone": "사랑"},
  {"id": "w39", "text": "다정한 말이 오가기를", "tone": "사랑"},
  {"id": "w40", "text": "같은 속도로 오래 걷기를", "tone": "사랑"},
  {"id": "w41", "text": "첫눈 오는 날 같이 있기를", "tone": "사랑"},
  {"id": "w42", "text": "고백이 따뜻하게 닿기를", "tone": "사랑"},
  {"id": "w43", "text": "다툰 뒤에도 먼저 웃기를", "tone": "사랑"},
  {"id": "w44", "text": "기념일을 잊지 않기를", "tone": "사랑"},
  {"id": "w45", "text": "그 사람 하루가 포근하길", "tone": "사랑"},
  {"id": "w46", "text": "설레는 마음 오래 가길", "tone": "사랑"},
  {"id": "w47", "text": "둘이 보는 노을이 곱기를", "tone": "사랑"},
  {"id": "w48", "text": "말하지 않아도 알아주기를", "tone": "사랑"},
  {"id": "w49", "text": "마음속 물결이 잔잔하기를", "tone": "평안"},
  {"id": "w50", "text": "걱정이 바람에 흩어지기를", "tone": "평안"},
  {"id": "w51", "text": "찻잔이 식을 때까지 느긋하기를", "tone": "평안"},
  {"id": "w52", "text": "하루 끝에 숨 돌리기를", "tone": "평안"},
  {"id": "w53", "text": "무거운 생각은 산에 두고 가길", "tone": "평안"},
  {"id": "w54", "text": "솔바람에 마음이 쉬어 가길", "tone": "평안"},
  {"id": "w55", "text": "서두르지 않고 걷기를", "tone": "평안"},
  {"id": "w56", "text": "작은 기쁨을 알아보기를", "tone": "평안"},
  {"id": "w57", "text": "비 온 뒤처럼 맑기를", "tone": "평안"},
  {"id": "w58", "text": "흔들려도 다시 서기를", "tone": "평안"},
  {"id": "w59", "text": "나에게 조금 너그럽기를", "tone": "평안"},
  {"id": "w60", "text": "돌 하나만큼 가벼워지길", "tone": "평안"}
]}
