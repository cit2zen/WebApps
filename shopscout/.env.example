# 데이터 수집 (없으면 해당 소스는 빈 결과로 우아하게 degrade)
FIRECRAWL_API_KEY=
EXA_API_KEY=

# LLM 선택: mock | api | agent-sdk
#  - mock     : 자격증명 없이 시연/E2E
#  - api      : Anthropic API 키 사용(서버 배포 권장). ANTHROPIC_API_KEY 필요
#  - agent-sdk: Claude Code 구독 자격증명(로컬/CLI 전용).
#               ⚠️ 배포 서버(next start, 컨테이너)에는 claude CLI·OAuth 로그인이 없어 LLM 호출이 실패합니다.
#               서버 배포 시 SHOPSCOUT_LLM=api 와 ANTHROPIC_API_KEY를 사용하세요.
# 미지정 시: ANTHROPIC_API_KEY가 있으면 api, 없으면 agent-sdk.
SHOPSCOUT_LLM=
ANTHROPIC_API_KEY=
# 모델 오버라이드(선택). 기본 claude-opus-4-8
SHOPSCOUT_MODEL=

# 소스 선택: real | mock (E2E/개발 시 mock)
SHOPSCOUT_SOURCES=real

# 저장소: (미지정=sqlite, 실패 시 memory) | memory
SHOPSCOUT_STORE=

# 동시성/스크랩 튜닝(선택)
SHOPSCOUT_LLM_CONCURRENCY=6
SHOPSCOUT_SCRAPE_CONCURRENCY=4
